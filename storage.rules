rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Фото байков: публичное чтение, запись — только владельцу
    match /bikes/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Видео трюков: публичное чтение (TikTok-лента), запись — только владельцу
    match /videos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Всё остальное — только для авторизованных
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
