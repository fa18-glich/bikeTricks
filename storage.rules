rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Фото байков: публичное чтение, запись — только владельцу, до 5 МБ, только изображения
    match /bikes/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')));
    }

    // Видео трюков: публичное чтение (TikTok-лента), запись — только владельцу, до 50 МБ
    match /videos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null
          || (request.resource.size < 50 * 1024 * 1024
            && request.resource.contentType.matches('(image|video)/(jpeg|png|webp|gif|mp4|webm|quicktime)')));
    }

    // Всё остальное — только для авторизованных, до 5 МБ
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.resource == null
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')));
    }
  }
}
