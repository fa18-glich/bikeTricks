rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Фото байков: чтение публичное, писать может только владелец папки (uid)
    match /bikes/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Всё остальное — только владелец или запрещено
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
