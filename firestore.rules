rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Пользовательские данные: читать могут авторизованные (нужно для поиска по коду друга),
    // писать — только владелец документа (uid в документе == auth.uid)
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Лидерборд: публичное чтение, запись только своей строки
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Реестр никнеймов: чтение публичное (проверка уникальности),
    // создание — только если имя ещё свободно и принадлежит автору
    match /nicknames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/nicknames/$(name));
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Гараж байков: чтение публичное, создание только своего байка,
    // обновление — владелец ИЛИ только поля лайков (likedBy/likes)
    match /bikes/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likes'])
      );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Видео-доказательства: чтение публичное (TikTok-лента), создание только своего видео,
    // обновление — владелец ИЛИ только поля реакций (likedBy/likes/ratedBy/ratingSum/ratingCount)
    match /videos/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likes', 'ratedBy', 'ratingSum', 'ratingCount'])
      );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Друзья: доступ только участникам пары
    match /friends/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.uids;
      allow update: if request.auth != null && request.auth.uid in resource.data.uids;
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }

    // Заявки в друзья: доступ только отправителю и получателю
    match /friend_requests/{id} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // Присутствие (онлайн/офлайн): чтение авторизованным, запись — только владелец
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Дуэли: чтение публичное (лента открытых дуэлей), изменения — только участники
    match /duels/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.challengerUid == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null && resource.data.challengerUid == request.auth.uid;
    }
  }
}
