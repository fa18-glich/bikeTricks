rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Валидаторы (анти-чит): значения прогресса/очков ограничены сверху ──
    function validSkill(s) {
      return s is map
        && s.id is string
        && (!('lv' in s) || (s.lv is number && s.lv >= 0 && s.lv <= 3))
        && (!('pr' in s) || (s.pr is number && s.pr >= 0 && s.pr <= 100))
        && (!('tr' in s) || (s.tr is number && s.tr >= 0 && s.tr <= 1000000))
        && (!('trToday' in s) || (s.trToday is number && s.trToday >= 0 && s.trToday <= 50))
        && (!('trSession' in s) || (s.trSession is number && s.trSession >= 0 && s.trSession <= 50));
    }
    function validSkills() {
      return request.resource.data.skills is list
        && request.resource.data.skills.size() == 5
        && validSkill(request.resource.data.skills[0])
        && validSkill(request.resource.data.skills[1])
        && validSkill(request.resource.data.skills[2])
        && validSkill(request.resource.data.skills[3])
        && validSkill(request.resource.data.skills[4]);
    }
    function validNickname(n) {
      return n is string && (n.size() == 0 || (n.size() >= 2 && n.size() <= 24));
    }
    // Запись своей строки users: uid совпадает + прогресс в допустимых пределах.
    // Поля проверяем только если они меняются (in) — legacy-документы без полей не блокируем.
    function validUserWrite() {
      return request.resource.data.uid == request.auth.uid
        && (!('skills' in request.resource.data) || validSkills())
        && (!('nickname' in request.resource.data) || validNickname(request.resource.data.nickname))
        && (!('challengeXP' in request.resource.data)
            || (request.resource.data.challengeXP is number
                && request.resource.data.challengeXP >= 0
                && request.resource.data.challengeXP <= 2000000));
    }
    // Лайк = добавление/удаление РОВНО своего uid в/из массива likedBy (ничего больше менять нельзя)
    function validLikeChange() {
      let oldL = resource.data.likedBy;
      let newL = request.resource.data.likedBy;
      let oldSz = oldL is list ? oldL.size() : 0;
      return newL is list
        && (
          (newL.size() == oldSz + 1 && request.auth.uid in newL && !(oldL is list && request.auth.uid in oldL))
          || (oldL is list && newL.size() == oldSz - 1 && request.auth.uid in oldL && !(request.auth.uid in newL))
        );
    }
    // Оценка = меняется ТОЛЬКО свой ключ в map ratedBy, значение 1..5 (сумму/среднее клиент считает из map)
    function validRatingChange() {
      let oldM = resource.data.ratedBy is map ? resource.data.ratedBy : {};
      let newM = request.resource.data.ratedBy;
      return newM is map
        && newM[request.auth.uid] is number
        && newM[request.auth.uid] >= 1
        && newM[request.auth.uid] <= 5
        && newM.diff(oldM).affectedKeys().hasOnly([request.auth.uid]);
    }

    // Пользовательские данные: читать могут авторизованные (нужно для поиска по коду друга),
    // писать — только владелец документа (uid в документе == auth.uid)
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if validUserWrite();
      allow update: if validUserWrite();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Лидерборд: публичное чтение, запись только своей строки
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pts is number
        && request.resource.data.pts >= 0
        && request.resource.data.pts <= 2000000
        && (!('nickname' in request.resource.data)
            || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 30));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Реестр никнеймов: чтение публичное (проверка уникальности),
    // создание — только если имя ещё свободно и принадлежит автору
    match /nicknames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/nicknames/$(name));
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Гараж байков: чтение публичное, создание только своего байка с валидными полями,
    // обновление — владелец ИЛИ только свой лайк (likedBy; счётчик likes больше не пишется — считаем из массива)
    match /bikes/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.ownerNick is string
        && request.resource.data.ownerNick.size() <= 40
        && request.resource.data.likedBy is list;
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
            && validLikeChange())
      );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Видео-доказательства: чтение публичное (TikTok-лента), создание только своего видео с валидными полями,
    // обновление — владелец ИЛИ только свой лайк (likedBy) или своя оценка (ratedBy)
    match /videos/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.pid is string
        && request.resource.data.ownerNick is string
        && request.resource.data.ownerNick.size() <= 40
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.skill is string
        && request.resource.data.likedBy is list
        && request.resource.data.ratedBy is map;
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
            && validLikeChange())
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratedBy'])
            && validRatingChange())
      );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Дружба создаётся ТОЛЬКО после принятой заявки (friend_requests.status=='accepted'),
    // чтобы нельзя было добавить человека в друзья без его согласия
    function validFriendCreate() {
      return request.resource.data.uids is list
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.requestId is string
        && exists(/databases/$(database)/documents/friend_requests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/friend_requests/$(request.resource.data.requestId)).data.status == 'accepted'
        && request.auth.uid == get(/databases/$(database)/documents/friend_requests/$(request.resource.data.requestId)).data.toUid
        && get(/databases/$(database)/documents/friend_requests/$(request.resource.data.requestId)).data.fromUid in request.resource.data.uids
        && get(/databases/$(database)/documents/friend_requests/$(request.resource.data.requestId)).data.toUid in request.resource.data.uids;
    }
    // Друзья: доступ только участникам пары
    match /friends/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null && validFriendCreate();
      allow update: if request.auth != null && request.auth.uid in resource.data.uids;
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }

    // Заявки в друзья: доступ только отправителю и получателю.
    // create — только от себя, статус pending, получатель не сам;
    // update (принять) — только получатель и только смена status на accepted
    match /friend_requests/{id} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.fromNick is string
        && request.resource.data.fromNick.size() <= 40
        && request.resource.data.toNick is string
        && request.resource.data.toNick.size() <= 40;
      allow update: if request.auth != null
        && resource.data.status == 'pending'
        && request.auth.uid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // Присутствие (онлайн/офлайн): чтение авторизованным, запись — только владелец
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Дуэли: чтение публичное (лента открытых дуэлей).
    // Безопасность: участник может менять ТОЛЬКО свой результат, победу подделать нельзя —
    // winnerUid должен совпадать с вычисленным по обоим результатам, а просроченную
    // дуэль (7+ дней) любой участник может пометить void
    match /duels/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.challengerUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.challenger is string
        && request.resource.data.skill is string
        && request.resource.data.target is string
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 1
        && request.resource.data.participants[0] == request.auth.uid;
      allow update: if request.auth != null && (
        // Свой результат: challenger записывает только challengerResult
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['challengerResult'])
          && request.auth.uid == resource.data.challengerUid
          && resource.data.status == 'active'
          && request.resource.data.challengerResult is number
          && request.resource.data.challengerResult > 0)
        // Свой результат: opponent записывает только opponentResult
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opponentResult'])
          && request.auth.uid == resource.data.acceptedByUid
          && resource.data.status == 'active'
          && request.resource.data.opponentResult is number
          && request.resource.data.opponentResult > 0)
        // Принятие дуэли любым авторизованным (не создателем)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy','acceptedByUid','status','participants'])
          && request.resource.data.status == 'active'
          && resource.data.status == 'open'
          && request.auth.uid != resource.data.challengerUid
          && !(request.auth.uid in resource.data.participants))
        // Завершение: победитель обязан совпадать с вычисленным по обоим результатам
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','winner','winnerUid'])
          && request.resource.data.status == 'done'
          && resource.data.status == 'active'
          && request.auth.uid in resource.data.participants
          && resource.data.challengerResult is number
          && resource.data.opponentResult is number
          && request.resource.data.winnerUid == (resource.data.challengerResult >= resource.data.opponentResult ? resource.data.challengerUid : resource.data.acceptedByUid))
        // Истечение: просроченную дуэль участник может пометить void
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'void'
          && resource.data.status in ['open','active']
          && request.auth.uid in resource.data.participants
          && resource.data.createdAt is timestamp
          && request.time - resource.data.createdAt > duration.value(7, 'd'))
      );
      allow delete: if request.auth != null && resource.data.challengerUid == request.auth.uid;
    }

    // ── Коллекции Telegram-бота поддержки: доступ только через Admin SDK (функции) ──
    match /tickets/{id} {
      allow read, write: if false;
    }
    match /faq/{id} {
      allow read, write: if false;
    }
    match /bot_state/{id} {
      allow read, write: if false;
    }
    match /tg_users/{id} {
      allow read, write: if false;
    }
    match /config/{id} {
      allow read, write: if false;
    }
  }
}
