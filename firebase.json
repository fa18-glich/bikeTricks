{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "**/*.md",
      "firestore.rules",
      "storage.rules",
      "firestore.indexes.json",
      "sw.js.map",
      "**/*firebase-adminsdk*.json",
      "**/*.bak",
      "package.json",
      "package-lock.json",
      "scripts/**",
      "css/**",
      "js/**",
      "worker/**"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
